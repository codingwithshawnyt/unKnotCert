{
  "title": "Phase 3: Persistence Invariance and Bottleneck Distance Analysis",
  "theorems": {
    "invariance": {
      "statement": "The 0-dimensional persistence diagram of (R(K), cr) is a knot invariant.",
      "proof": "R(K) is the same graph for all diagrams of K. Therefore the filtered graph and its persistence diagram are the same regardless of starting diagram.",
      "caveat": "Vacuously useful: R(K) cannot be computed. In practice, we only see subgraphs, and their PDs depend on exploration depth."
    }
  },
